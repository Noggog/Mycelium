# Copy to `.env` (next to compose.yaml) and fill in. `.env` is gitignored — never commit secrets.
# Komodo can inject these instead of a file if you prefer.

# Host port the app's HTTP server is published on. Point your reverse proxy at this.
HTTP_PORT=43105

# Public URL your reverse proxy serves this app at (scheme + host, no trailing slash). Drives the
# OIDC redirect and must match the redirect URI registered in Authentik (origin + /signin-oidc).
PUBLIC_ORIGIN=https://music.example.com

# --- OIDC (Authentik) ---
# Authority is the application's issuer URL (note the trailing slash).
OIDC_AUTHORITY=https://authentik.example.com/application/o/mycelium/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Plex ---
# Only the address. The credential is not configured here: connect Plex from the dev panel
# ("Link with Plex"), which stores a server-scoped token in Mongo and can re-mint it without a deploy.
PLEX_ENDPOINT=http://192.168.1.232:32400
# PLEX_LIBRARY=Music   # optional; defaults to the first artist-type library

# --- Metadata archive (git) ---
# A nightly commit of everything we own that a machine can't re-derive: the library inventory, who
# likes which artist, per-user verdicts, who brought each record in, blocks and identity pins. The
# point is ownership — if Mongo, Plex and Authentik all vanished, this repo plus the music files is
# enough to rebuild.
#
# Archiving is ON for any container deployment. Where the repository lives is set in compose.yaml,
# not here — it's the directory bound to /archive. The archive names people (usernames, display
# names): KEEP THE REPOSITORY PRIVATE.
#
# Optional push target. Unset means commit locally only — already a complete copy, since the remote
# is redundancy rather than the product, and a push failure never fails a snapshot.
#   HTTPS with a token:  https://<user>:<token>@git.example.com/you/mycelium-metadata.git
# NOTE: a token embedded in the URL is written to the archive's .git/config on disk. That file is on
# the host path above, not in the image or in this repo — but treat it as a secret, and prefer a
# token scoped to just this one repository. The app redacts the credential wherever the remote
# reaches a log line or an API response, so it should not appear in logs/backend-*.log.
# METADATA_REPO_REMOTE=
# A self-hosted remote reached by IP almost always has a self-signed certificate, which git refuses
# by default ("SSL certificate problem"). Either use http:// if the server offers it, or set this:
# GIT_SSL_NO_VERIFY=true
#
# The remote repository must be EMPTY. If it was created with an initial commit (a README or a
# licence), the first push is rejected as a non-fast-forward and the archive will log a push failure
# every night while committing happily to the local copy.
# METADATA_REPO_BRANCH=main            # branch to commit on
# METADATA_COMMIT_NAME=Mycelium        # commit author (there is no global gitconfig in the image)
# METADATA_COMMIT_EMAIL=mycelium@localhost
# METADATA_ARCHIVE_HOUR_OFFSET=2       # hours past DAILY_SYNC_HOUR; the default puts the snapshot
#                                      # after both daily syncs, so it records a fresh library
# METADATA_GIT_TIMEOUT_MINUTES=5       # ceiling on any single git invocation

# --- Deezer downloads (streamrip) ---
# Host path to the music library Plex scans; downloads land here (bind-mounted to /music).
MUSIC_DOWNLOAD_DIR_HOST=/srv/media/music
# Host path holding streamrip's config (config.toml with your Deezer ARL). Created on first run.
STREAMRIP_CONFIG_HOST=/srv/appdata/mycelium/streamrip
# Automatic vs. manual downloading is NOT an env var: it is the switch on the Download page,
# stored in Mongo (automatic until you turn it off). The "Download now" button works either way.
# TIMER_JITTER_PERCENT=30             # random +/- spread on EVERY recurring wait (0 = exact timing)
# DOWNLOAD_SETTLE_INTERVAL_MINUTES=15  # how often to re-read Plex while a download waits to land
# DOWNLOAD_SETTLE_WINDOW_HOURS=6       # how long to keep watching for it before leaving it to the daily sync
# DEEZER_QUALITY=2                   # 2 = FLAC, 1 = 320 kbps MP3
# DEEZER_FALLBACK_QUALITY            # LEAVE UNSET: the ladder is derived from DEEZER_QUALITY, i.e.
#                                    # keep downgrading (2 -> 1 -> 0) until Deezer will actually serve
#                                    # each track. Needed because Deezer's formats vary PER TRACK: an
#                                    # album can have a 320 master for one track and only 128 for the
#                                    # rest. Results merge per track, so lossless is never downgraded.
#                                    # Set explicitly (comma-separated, best first) to override, or to
#                                    # blank to refuse downgrades and accept incomplete albums.
