<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Expose internal helpers (e.g. PlexArtistTagger.ReconcileCollections) to the test project. -->
        <InternalsVisibleTo Include="Mycelium.Tests" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspnetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <!-- Starter playlist covers. LogicalName pins the resource key so it survives a namespace
             rename - PlaylistArt looks them up by "Posters/{id}.jpg", not by assembly namespace. -->
        <EmbeddedResource Include="Assets\Posters\*.jpg" LogicalName="Posters/%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" Version="9.3.1" />
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.7" />
        <PackageReference Include="MongoDB.Driver" Version="3.4.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.7" />
        <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
        <PackageReference Include="System.Reactive" Version="6.0.1" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mycelium.Deezer\Mycelium.Deezer.csproj" />
        <ProjectReference Include="..\Mycelium.ListenBrainz\Mycelium.ListenBrainz.csproj" />
        <ProjectReference Include="..\Mycelium.MongoDB\Mycelium.MongoDB.csproj" />
        <ProjectReference Include="..\Mycelium.Plex\Mycelium.Plex.csproj" />
        <ProjectReference Include="..\ServiceDefaults\ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
